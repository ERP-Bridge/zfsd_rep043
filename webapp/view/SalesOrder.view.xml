<mvc:View
    controllerName="zfsd_rep043.controller.SalesOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <Page id="salesOrderPage" title="Sales Order Creation" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <VBox id="salesOrderMainVBox" class="sapUiMediumMargin">
                <Toolbar id="salesOrderActionToolbar" design="Transparent">
                    <Button id="salesOrderBackButton" text="Back" icon="sap-icon://nav-back" type="Transparent" press=".onNavBack" />
                    <ToolbarSpacer />
                    <Button id="salesOrderMailButton" text="Mail to..." icon="sap-icon://email" type="Transparent" />
                    <Button id="salesOrderPrintButton" text="Print" icon="sap-icon://print" type="Transparent" />
                    <Button id="salesOrderExportButton" text="Export As..." icon="sap-icon://excel-attachment" type="Transparent" />
                    <Button id="salesOrderSaveButton" text="Save" icon="sap-icon://save" type="Transparent" press=".onSave" />
                    <Button id="salesOrderDiscardDraftButton" text="Discard Draft" icon="sap-icon://delete" type="Transparent"
                        visible="{selectedQuotation>/draftSaved}" press=".onDiscardDraft" />
                    <Button id="salesOrderConfirmButton" text="Confirm Sales Order" icon="sap-icon://accept" type="Emphasized" press=".onConfirmSalesOrder" />
                </Toolbar>

                <Panel id="salesOrderHeaderPanel" class="sapUiMediumMarginTop">
                    <HBox width="100%" justifyContent="SpaceBetween" alignItems="Start">
                        <VBox width="70%"><Label text="Profit center"/><Text text="{selectedQuotation>/profitCenter}" wrapping="true"/></VBox>
                        <VBox width="22%"><Label text="Customer Approval"/><ObjectStatus text="{selectedQuotation>/approvalStatus}" state="{selectedQuotation>/statusState}" inverted="true"/></VBox>
                    </HBox>
                </Panel>

                <Panel id="customerDetailsPanel" class="sapUiMediumMarginTop">
                    <VBox>
                        <HBox width="100%" justifyContent="SpaceBetween" alignItems="Start">
                            <VBox width="22%"><Label text="Sold to customer"/><Text text="{selectedQuotation>/soldToCustomer}" wrapping="true"/></VBox>
                            <VBox width="22%"><Label text="Bill to customer"/><Text text="{selectedQuotation>/billToCustomer}" wrapping="true"/></VBox>
                            <VBox width="22%"><Label text="E-mail of contact"/><Text text="{selectedQuotation>/contactEmail}" wrapping="true"/></VBox>
                            <VBox width="22%" visible="{selectedQuotation>/showEpmContract}"><Label text="EPM contract"/><Text text="{selectedQuotation>/epmContract}"/></VBox>
                            <VBox width="5%" alignItems="End"><Button icon="{path:'uiModel>/customerDetailsVisible',formatter:'.formatEyeIcon'}" type="Emphasized" press=".onToggleCustomerDetails"/></VBox>
                        </HBox>
                        <HBox width="100%" justifyContent="SpaceBetween" alignItems="Start" class="sapUiMediumMarginTop" visible="{uiModel>/customerDetailsVisible}">
                            <VBox width="30%"><Label text="Sold to:"/><Text text="{selectedQuotation>/soldToName}"/><Text text="{selectedQuotation>/soldToAddress}"/><Text text="{selectedQuotation>/soldToCity}"/><Text text="{selectedQuotation>/soldToVat}"/></VBox>
                            <VBox width="30%"><Label text="Bill to:"/><Text text="{selectedQuotation>/billToName}"/><Text text="{selectedQuotation>/billToAddress}"/><Text text="{selectedQuotation>/billToCity}"/><Text text="{selectedQuotation>/billToVat}"/></VBox>
                            <VBox width="35%"><Label text="Ship to:"/><ComboBox width="100%" selectedKey="{uiModel>/selectedShipToKey}" selectionChange=".onShipToChange" items="{selectedQuotation>/shipToOptions}"><core:Item key="{selectedQuotation>key}" text="{selectedQuotation>text}"/></ComboBox><Text text="{uiModel>/selectedShipToAddress}" wrapping="true" class="sapUiTinyMarginTop"/></VBox>
                        </HBox>
                    </VBox>
                </Panel>

                <Panel id="additionalInformationPanel" headerText="Additional information :" class="sapUiMediumMarginTop">
                    <TextArea value="{selectedQuotation>/additionalInfo}" width="100%" rows="4" placeholder="Enter additional information"/>
                </Panel>

                <Panel id="serviceDetailsPanel" class="sapUiMediumMarginTop">
                    <VBox>
                        <HBox width="100%" justifyContent="SpaceBetween" alignItems="Start">
                            <VBox width="18%"><Label text="Service date from"/><DatePicker value="{selectedQuotation>/serviceDateFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" width="100%"/></VBox>
                            <VBox width="18%"><Label text="Service date to"/><DatePicker value="{selectedQuotation>/serviceDateTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" width="100%"/></VBox>
                            <VBox width="20%"><Label text="Customer PO num"/><Input value="{selectedQuotation>/customerPoNum}" width="100%" maxLength="35"/></VBox>
                            <VBox width="18%"><Label text="Posting Date"/><DatePicker value="{selectedQuotation>/postingDate}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" width="100%" change=".onPostingDateChange"/></VBox>
                            <VBox width="10%"><Label text="Currency"/><Text text="{selectedQuotation>/currency}"/></VBox>
                            <VBox width="5%" alignItems="End"><Button icon="{path:'uiModel>/serviceDetailsVisible',formatter:'.formatEyeIcon'}" type="Emphasized" press=".onToggleServiceDetails"/></VBox>
                        </HBox>
                        <VBox
    id="buyerReferenceVBox"
    class="sapUiMediumMarginTop"
    visible="false">

    <Label
        id="buyerReferenceLabel"
        text="Buyer reference" />

    <Input
        id="buyerReferenceInput"
        value="{selectedQuotation>/buyerReference}"
        width="35%"
        maxLength="35"
        placeholder="Enter buyer reference" />
</VBox>
                    </VBox>
                </Panel>

                <Panel id="attachmentsPanel" class="sapUiMediumMarginTop salesOrderAttachmentPanel">
                    <VBox>
                        <HBox width="100%" justifyContent="SpaceBetween" alignItems="Center"><Title text="{path:'selectedQuotation>/attachments',formatter:'.formatAttachmentsTitle'}" level="H3"/><Button icon="{path:'uiModel>/attachmentsVisible',formatter:'.formatEyeIcon'}" type="Emphasized" press=".onToggleAttachments"/></HBox>
                        <VBox visible="{uiModel>/attachmentsVisible}" class="sapUiSmallMarginTop"><Text text="Select the documents you wish to share with your contacts."/><HBox width="100%" justifyContent="SpaceBetween" class="sapUiSmallMarginTop"><List width="58%" items="{selectedQuotation>/attachments}" noDataText="No attachments"><CustomListItem><HBox alignItems="Center"><CheckBox selected="{selectedQuotation>selected}"/><Link text="{selectedQuotation>name}" press=".onPreviewAttachment" class="sapUiTinyMarginBegin"/><Button icon="sap-icon://delete" type="Transparent" press=".onDeleteAttachment"/></HBox></CustomListItem></List><HBox width="40%" justifyContent="End" alignItems="Center"><u:FileUploader id="attachmentFileUploader" width="24rem" buttonText="Browse" change=".onAttachmentFileChange"/><Button text="Upload" type="Emphasized" press=".onUploadAttachment" class="sapUiTinyMarginBegin"/></HBox></HBox></VBox>
                    </VBox>
                </Panel>

                <Panel id="itemsPanel" headerText="Items" class="sapUiMediumMarginTop">
                    <Table id="salesOrderItemsTable" inset="false" fixedLayout="false" noDataText="No quotation items available" items="{selectedQuotation>/items}">
                        <columns>
                            <Column width="17rem"><Text text="WBS"/></Column><Column width="23rem"><Text text="Article"/></Column><Column width="8rem" hAlign="Center"><Text text="Quantity"/></Column><Column width="7rem" hAlign="End"><Text text="Unit price"/></Column><Column width="6rem" hAlign="Center"><Text text="Currency"/></Column><Column width="8rem" hAlign="End"><Text text="NetTotal"/></Column><Column width="6rem" hAlign="Center"><Text text="VAT %"/></Column><Column width="8rem" hAlign="End"><Text text="Gross"/></Column><Column width="6rem" hAlign="Center"><Text text="Actions"/></Column>
                        </columns>
                        <items><ColumnListItem vAlign="Top"><cells>
                            <VBox><Text text="{selectedQuotation>wbs}"/><Label text="Additional description" class="sapUiSmallMarginTop"/></VBox>
                            <VBox><Text text="{selectedQuotation>articleDescription}" wrapping="true"/><Input value="{selectedQuotation>additionalDescription}" width="100%" class="sapUiSmallMarginTop"/></VBox>
                            <VBox alignItems="Center"><Input value="{selectedQuotation>quantity}" width="6rem" type="Number" textAlign="End" liveChange=".onItemQuantityChange" change=".onItemQuantityChange"/></VBox>
                            <Text text="{selectedQuotation>unitPrice}" textAlign="End"/><Text text="{selectedQuotation>currency}" textAlign="Center"/><Text text="{selectedQuotation>netTotal}" textAlign="End"/><Text text="{selectedQuotation>vat}" textAlign="Center"/><Text text="{selectedQuotation>gross}" textAlign="End"/><Button icon="sap-icon://copy" type="Transparent" tooltip="Copy item"/>
                        </cells></ColumnListItem></items>
                    </Table>
                </Panel>

                <HBox width="100%" justifyContent="End" class="sapUiMediumMarginTop"><VBox width="55%"><Table inset="false" fixedLayout="true" noDataText="No totals calculated" items="{selectedQuotation>/totals}"><columns><Column width="20%" hAlign="End"><Text text="VAT %"/></Column><Column width="27%" hAlign="End"><Text text="Total net"/></Column><Column width="26%" hAlign="End"><Text text="Total VAT"/></Column><Column width="27%" hAlign="End"><Text text="Total gross"/></Column></columns><items><ColumnListItem highlight="{= ${selectedQuotation>isGrandTotal} ? 'Information' : 'None' }"><cells><Text text="{selectedQuotation>vat}" textAlign="End"/><Text text="{selectedQuotation>totalNet}" textAlign="End"/><Text text="{selectedQuotation>totalVat}" textAlign="End"/><Text text="{selectedQuotation>totalGross}" textAlign="End"/></cells></ColumnListItem></items></Table></VBox></HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
