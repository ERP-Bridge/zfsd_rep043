{
  "_version": "1.86.0",
  "sap.app": {
    "id": "zo2c_rep043",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
   "resources": "resources.json",
"dataSources": {
  "quotationService": {
    "uri": "/sap/opu/odata4/sap/zui_ebill_adhoc_sales_o4/srvd_a2x/sap/zebill_adhoc_sales_srv/0001/",
    "type": "OData",
    "settings": {
      "odataVersion": "4.0"
    }
  }
},
"sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.28.0",
      "toolsId": "380d4a89-636d-4ded-abd2-f0f423fb1353"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.150.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
"models": {
  "i18n": {
    "type": "sap.ui.model.resource.ResourceModel",
    "settings": {
      "bundleName": "zo2c_rep043.i18n.i18n"
    }
  },
"quotationModel": {
  "type": "sap.ui.model.json.JSONModel"
},
  "quotationOData": {
    "dataSource": "quotationService",
    "preload": true,
    "settings": {
      "operationMode": "Server",
      "synchronizationMode": "None",
      "autoExpandSelect": true,
      "earlyRequests": true
    }
  }
},
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "zo2c_rep043.view",
        "async": true,
        "viewPath": "zo2c_rep043.view"
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
          ]
        },
        {
          "name": "RouteSalesOrder",
          "pattern": "SalesOrder/{qNumber}",
          "target": "TargetSalesOrder"
        }
      ],
      "targets": {
        "TargetView1": {
          "id": "View1",
          "name": "View1"
        },
        "TargetSalesOrder": {
          "id": "SalesOrder",
          "name": "SalesOrder"
        }
      }
    },
    "rootView": {
      "viewName": "zo2c_rep043.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}